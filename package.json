  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "esbuild": "^0.17.19"
  }
}
